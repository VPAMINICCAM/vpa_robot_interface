<launch>
    <!-- Define arguments with default values -->
    <arg name="debug_mode" default="false" />
    <arg name="direct_throttle" default="false" />
    <arg name="start_imu" default="true" /> <!-- Argument to control IMU launch -->

    <!-- Launch the actuator node -->
    <node name="actuator" 
          pkg="vpa_robot_interface" 
          type="traction_node.py" 
          output="screen" 
          required="true">

        <!-- Parameters -->
        <param name="wheel_diameter" value="0.045"/> <!-- Example: 45mm diameter -->
        <param name="debug_mode" value="$(arg debug_mode)" /> <!-- Debug mode -->
        <param name="direct_throttle" value="$(arg direct_throttle)" /> <!-- Direct throttle -->
    </node>

    <!-- Conditionally include the IMU node -->
    <group if="$(arg start_imu)">
        <include file="$(find vpa_robot_interface)/launch/vpa_imu.launch" />
    </group>
</launch>
